{
  "name": "onward",
  "version": "1.16.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "node --import=tsx prisma/seed.ts",
    "check": "svelte-kit sync && svelte-check --fail-on-warnings",
    "format": "prettier --check \"**/*.{svelte,js,ts,md,html,css,json,yaml}\"",
    "lint": "eslint \"**/*.{svelte,js,ts}\"",
    "prepare": "svelte-kit sync || echo '' && node \"./.husky/install.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/cloudfront-signer": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@valkey/valkey-glide": "2.0.1",
    "exceljs": "^4.4.0",
    "openai": "^5.23.2",
    "weaviate-client": "^3.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lucide/svelte": "^0.511.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/enhanced-img": "^0.8.5",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
