    "prisma": "^7.10.0",
    "svelte": "5.55.7",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "uuid": "^14.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "cookie": "0.7.2",
      "deepmerge-ts": "8.0.0",
