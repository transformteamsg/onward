# Used for Learning Unit podcast creation.
APP_URL=http://localhost:5173

# The connection string to Valkey.
VALKEY_URL=xxx

# The connection string to PostgreSQL.
POSTGRES_URL=xxx

# The connection details to S3.
S3_PROVIDER=minio
S3_ACCESS_KEY=minioaccesskey
S3_SECRET_KEY=miniosecretkey
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=onward

# The connection details to Weaviate.
WEAVIATE_URL=http://localhost:50050
WEAVIATE_GRPC_URL=http://localhost:50051
WEAVIATE_API_KEY=secret
WEAVIATE_OPENAI_API_KEY=xxx
WEAVIATE_OPENAI_BASE_URL=xxx
WEAVIATE_OPENAI_EMBEDDING_API_KEY=xxx

# The OpenAI credentials.
OPENAI_API_KEY=xxx
OPENAI_BASE_URL=xxx

# The Google OAuth2 credentials.
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_HOSTED_DOMAIN=

# The per-learner limits on the model-backed chat endpoint (POST /api/messages).
# Each value must be a positive integer. A value that is unset or invalid falls back to the
# default shown in the comment above it.
#
# The number of requests one learner may send per window. Default: 20.
CHAT_RATE_LIMIT_MAX_REQUESTS=20
# The length of the request window, in seconds. Default: 60.
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# The number of completions one learner may have in flight at once. Default: 2.
CHAT_MAX_CONCURRENT_REQUESTS=2
# The largest accepted prompt, in characters. Default: 2000.
CHAT_MAX_QUERY_LENGTH=2000
